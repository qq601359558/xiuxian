# 《天道因果录》配置样例 — 复制为 .env 后修改；.env 不要提交到仓库
# cp .env.example .env

# ===== AI 通道（正式体验必填一项）=====
# OpenAI 兼容接口（默认 DeepSeek；可换通义千问 / 智谱 / Ollama 等兼容站）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 主聊天通道超时（秒），默认 30，可调区间 5–120（非法值回退 30）；慢中转/慢模型建议调大，如 60
LLM_TIMEOUT_SECONDS=30
# 或走本机 CC Switch（Claude Code 本地代理）：USE_CCSWITCH=1 时忽略上面三项
USE_CCSWITCH=0

# ===== AI 运行模式 =====
# AI_REQUIRED=1（默认）：无可用 AI 时，交谈/斗法/自由言行等交互直接拒绝并提示
# ALLOW_LOCAL_AI=1：允许本地模板降级（联调/测试用；正式灰度建议保持 0）
AI_REQUIRED=1
ALLOW_LOCAL_AI=0

# ===== 运行环境 =====
# test：闭关墙钟可加速（TIME_SCALE 默认 120）；production：强制与现实同步（×1）
GAME_ENV=test
TIME_SCALE=120

# ===== 局域网服 =====
LAN_HOST=0.0.0.0
LAN_PORT=8765
# 后台 NPC 议程 tick 间隔（秒）；0 = 关闭自动 tick
NPC_TICK_INTERVAL=120
